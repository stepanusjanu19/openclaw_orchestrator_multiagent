# ═══════════════════════════════════════════════════════════════
# OpenClaw Multi-Agent Platform — Global Credentials (TEMPLATE)
# Salin file ini menjadi .env dan isi nilai-nilainya sesuai environment Anda
# ═══════════════════════════════════════════════════════════════

# ── OpenClaw Gateway ──────────────────────────────────────────
# URL OpenClaw Gateway Anda (contoh: http://127.0.0.1:14000/v1/chat/completions)
OPENCLAW_GW_URL=
# Token keamanan untuk akses ke OpenClaw Gateway
OPENCLAW_GW_TOKEN=

# ── Downstream AI Router (9Router / OmniRoute / Custom) ───────
# Public endpoint project tetap webhook relay. Router ini hanya downstream private untuk agent runtime.
AI_ROUTER_ENABLED=false
# openclaw | 9router | omniroute | custom
AI_ROUTER_PROVIDER=openclaw
# Base URL OpenAI-compatible router. 9Router/OmniRoute lokal default: http://127.0.0.1:20128/v1
AI_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
# Optional bearer token router. Jangan pakai default secret bawaan tool pihak ketiga.
AI_ROUTER_TOKEN=
# Default aman: hanya loopback/localhost. Jangan expose port router ke internet.
AI_ROUTER_REQUIRE_LOOPBACK=true
# Ubah true hanya jika memakai endpoint cloud HTTPS yang memang dipercaya.
AI_ROUTER_ALLOW_CLOUD=false
# Comma-separated exact/glob model allowlist. Kosong berarti mengikuti model agent.
# Contoh: openclaw/*,gpt-4o-mini,claude-3-5-*
AI_ROUTER_MODEL_ALLOWLIST=
AI_ROUTER_TIMEOUT_MS=30000
AI_ROUTER_MAX_RESPONSE_BYTES=2097152
# Tool calls melalui router default mati agar prompt dari webhook publik tidak bisa memperluas blast radius.
AI_ROUTER_ALLOW_TOOL_CALLS=false
# Default listen host/port saat 9Router atau OmniRoute dijalankan dari menu Code Tools.
# Host tetap harus loopback; UI tidak mendukung public bind untuk router.
AI_ROUTER_LISTEN_HOST=127.0.0.1
AI_ROUTER_9ROUTER_PORT=20128
AI_ROUTER_OMNIROUTE_PORT=20129

# ── Go API Backend ────────────────────────────────────────────
API_PORT=8080
API_HOST=127.0.0.1

# ── Dashboard Auth ────────────────────────────────────────────
# Password untuk masuk ke web dashboard.
# Jangan biarkan kosong/default "admin" di environment yang terekspos jaringan.
DASHBOARD_PASSWORD=

# Path executable Node.js (isi jika Go gagal menemukan "node" di sistem Anda)
NODE_BIN=

# ── Frontend (CORS origin) ────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Paths ─────────────────────────────────────────────────────
# Path menuju direktori .openclaw
OPENCLAW_WORKSPACE_DIR=
# Path absolut menuju folder bots di project ini
BOTS_DIR=

# ── Telegram MTProto UserBot (BotFather Automation) ──────────
# Dapatkan dari: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Nomor Telegram Anda (format internasional, contoh: +628123456789)
TELEGRAM_PHONE=

# ── AI Inference & Embedding (Lokal / Ollama) ─────────────────────
# URL lengkap ke endpoint chat Ollama lokal
OLLAMA_DIRECT_URL=http://127.0.0.1:11434/api/chat
# Base URL Ollama (untuk embedding)
OLLAMA_EMBED_URL=http://127.0.0.1:11434
# Model embedding yang dipakai oleh memory.js
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Cognitive Persistence Memory (pgvector) ──────────────────────
# Connection string ke PostgreSQL lokal dengan ekstensi pgvector
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
OPENCLAW_PGVECTOR_URL=

# ── Security Enhancement V1 ──────────────────────────────────────
# MASKING_MODE: off | on | strict
MASKING_MODE=on
# LOGGING_MODE: minimal | audit | debug
LOGGING_MODE=audit
TEMPLATE_RENDERING_ENABLED=true
# Default: credentials/security (ignored by git)
SECURITY_STORE_DIR=
# Optional. Jika kosong, backend membuat credentials/security/.store-key lokal.
SECURITY_STORE_KEY=

# ── Gateway Public Hardening ──────────────────────────────────
# CIDR proxy/CDN yang boleh dipercaya untuk header real-IP seperti
# CF-Connecting-IP, True-Client-IP, X-Real-IP, dan X-Forwarded-For.
# Isi dengan CIDR Cloudflare/reverse proxy yang benar saat expose produksi.
# Loopback otomatis dipercaya untuk tunnel lokal seperti ngrok.
GATEWAY_TRUSTED_PROXY_CIDRS=
# Opsional: kosong berarti semua CIDR boleh. Deny dievaluasi sebelum allow.
GATEWAY_ALLOW_CIDRS=
GATEWAY_DENY_CIDRS=
# GeoIP default offline/unknown. Isi path DB lokal jika tersedia; API eksternal tetap opt-in.
GATEWAY_GEOIP_DB_PATH=
GATEWAY_GEOIP_API_ENABLED=false
# Comma-separated URL template provider GeoIP; {ip} akan diganti IP visitor.
# Contoh: https://ipapi.co/{ip}/json/,https://ipinfo.io/{ip}/json
GATEWAY_GEOIP_API_URLS=
GATEWAY_GEOIP_API_TIMEOUT_MS=800
# Simpan visitor intelligence ke PostgreSQL menggunakan OPENCLAW_PGVECTOR_URL.
GATEWAY_VISITOR_STORE=true
# 0 menonaktifkan cleanup otomatis. Default 30 hari untuk membatasi penyimpanan raw visitor IP.
GATEWAY_VISITOR_RETENTION_DAYS=30
# Reverse DNS lookup bisa menambah konteks provider, tapi default mati agar tidak melakukan query DNS eksternal.
GATEWAY_VISITOR_DNS_LOOKUP=false
# Abuse defense menyimpan signal names + score tanpa fingerprint mentah.
GATEWAY_ABUSE_DEFENSE_ENABLED=true
GATEWAY_ABUSE_THROTTLE_SCORE=35
GATEWAY_ABUSE_BLOCK_SCORE=85
